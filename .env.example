# Resend (https://resend.com) credentials — used by api/book.js to email
# booking form submissions to dantathedentalcompany@gmail.com.
# See the setup guide for how to get an API key.

# Your Resend API key (Dashboard > API Keys > Create API Key).
RESEND_API_KEY=

# Optional overrides — safe to leave unset, defaults shown below.

# Where booking notifications get sent.
# NOTIFY_EMAIL=dantathedentalcompany@gmail.com

# The "from" address Resend sends as. Until you verify your own domain
# at resend.com/domains, this MUST stay onboarding@resend.dev — Resend
# rejects any other "from" address on an unverified account.
# RESEND_FROM_EMAIL=Danta Website <onboarding@resend.dev>
