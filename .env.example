# WhatsApp Cloud API credentials — used by api/book.js to send booking
# notifications straight to Danta's WhatsApp. See the setup guide for how
# to obtain each value from Meta for Developers > WhatsApp > API Setup.

# Permanent access token for a System User with whatsapp_business_messaging
# permission (NOT the 24-hour temporary token from the quickstart page).
WHATSAPP_TOKEN=

# The "Phone number ID" of the WhatsApp Business number that SENDS the
# notification (found on the API Setup page, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# The phone number that should RECEIVE booking notifications (Danta's own
# WhatsApp, in international format with no + or spaces), e.g. 917395810278
WHATSAPP_NOTIFY_TO=

# Name of the approved message template used to send the notification
# (see setup guide — e.g. new_booking_request)
WHATSAPP_TEMPLATE_NAME=
